{
    "manufacturer": "eu(kiramantler)",
    "keyboard_name": "rotary_encoder_test",
    "maintainer": "kiramantler",
    "usb": 
	{
        "device_version": "1.0.0",
        "pid": "0x0110",
        "vid": "0xB0B2"
    },

    "bootloader": "rp2040",
    "processor": "RP2040",
	
	"features":
