		"encoder": true,
		"rgb_matrix": true,
		"extrakey": true,
		"backlight": false,
		"rgblight":false
	},
	
	"diode_direction": "COL2ROW",
	"matrix_pins": {
		"direct": [
			["GP14"]
		]
	},
	
	"encoder":
	{
		"rotary":
		[
			{ "pin_a": "GP15", "pin_b": "GP27", "resolution": 4 }
		]
	},
	
	"layouts": 
	{
		"LAYOUT":
		{
			"layout": 
			[
				{"matrix": [0,0], "x": 0, "y": 0}
			]
		}
	},
	
	"rgb_matrix": {
		"animations":
		{
			"breathing":true
		},
		"center": [0,0],
		"default":
		{
			"animation": "breathing"
		},
		"driver": "ws2812",
		"layout":
		[
			{"matrix": [0,0], "x": 0, "y":0, "flags":255}
		],
		"max_brightness": 200
	},
	
	"ws2812":
	{
		"driver": "vendor",
		"pin": "GP16"
	}
}
